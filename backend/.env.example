# Required for the complete MVP
PORT=5001
NODE_ENV=production
CLIENT_URL=https://app.example.invalid
MONGODB_URI=mongodb+srv://username:password@cluster.example.invalid/chutki

# Generate independent, random values in the deployment platform. Never commit them.
JWT_SECRET=replace-in-deployment-platform
SESSION_SECRET=replace-in-deployment-platform
JWT_EXPIRES_IN=7d

# Recommended MVP production defaults
DISABLE_AI_CHAT=true
GENERAL_RATE_LIMIT=300
PUBLIC_TOOL_RATE_LIMIT=60
METERED_TOOL_RATE_LIMIT=30

# Runtime directories; processed images normally remain in memory.
MAX_FILE_SIZE=8388608
UPLOAD_DIR=uploads
FILE_RETENTION_MINUTES=30

# Not configured in the first production release:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# RESEND_API_KEY=
# EMAIL_FROM=
# OPENAI_API_KEY is intentionally not required while AI chat is disabled.
